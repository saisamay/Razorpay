DATABASE_URL=postgresql+psycopg://recovery:recovery@postgres:5432/recovery
REDIS_URL=redis://redis:6379/0
RAZORPAY_WEBHOOK_SECRETS=replace-with-a-long-random-secret
APP_ENVIRONMENT=test
MAX_WEBHOOK_BYTES=1048576
PROCESSING_TIMEOUT_SECONDS=900
REDIS_CLAIM_IDLE_MS=60000
# Required outside local/test environments to authorize replay and DLQ inspection.
INTERNAL_API_TOKEN=
# Required for automatic Razorpay API reconciliation of timed-out payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1
RECONCILIATION_TIMEOUT_SECONDS=5
